# Copy this file to .env in the same directory
# Replace the placeholder values with your actual API keys

# Anon Aadhaar App ID (optional)
REACT_APP_APP_ID=

# Lighthouse Storage API Key (REQUIRED for file uploads)
# Get your API key from: https://files.lighthouse.storage/
REACT_APP_LIGHTHOUSE_API_KEY=

# Instructions to get Lighthouse API Key:
# 1. Visit: https://files.lighthouse.storage/
# 2. Sign up/login with your GitHub account
# 3. Go to "API Keys" section in dashboard
# 4. Click "Create New API Key"
# 5. Copy the generated API key
# 6. Paste it above (replace the empty value after the = sign)
# 7. Save this file as .env (remove .template from filename)
# 8. Restart the development server: npm start

